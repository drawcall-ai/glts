import * as THREE from "three"
import { gltsLoader, onDispose, onFrame, scene } from "@drawcall/glts"

// The root asset. It sweeps its own trunk, then asks the contextual loader for
// branch.glts twice: once as a scene for the low bough, once as an instanced
// crown it re-poses every frame.

scene.name = "Dusk tree"

const BRANCHES = 15
const MOTES = 130
const UP = new THREE.Vector3(0, 1, 0)
const WIND = new THREE.Vector3(0.44, 0, -0.9).normalize()

function seeded(seed: number): () => number {
  let state = seed >>> 0
  return () => {
    state = (state + 0x6d2b79f5) >>> 0
    let value = Math.imul(state ^ (state >>> 15), 1 | state)
    value = (value + Math.imul(value ^ (value >>> 7), 61 | value)) ^ value
    return ((value ^ (value >>> 14)) >>> 0) / 4294967296
  }
}

const random = seeded(0x7a11)

function canvasContext(width: number, height: number): CanvasRenderingContext2D {
  const canvas = document.createElement("canvas")
  canvas.width = width
  canvas.height = height
  const context = canvas.getContext("2d")
  if (!context) {
    throw new Error("2D canvas context is unavailable")
  }
  return context
}

// Bark, drawn once into a canvas. The wobble completes whole cycles over the
// height so the texture tiles in both directions.
function createBarkTexture(): THREE.CanvasTexture {
  const width = 256
  const height = 512
  const context = canvasContext(width, height)
  context.fillStyle = "#43301f"
  context.fillRect(0, 0, width, height)
  context.lineCap = "round"

  for (let streak = 0; streak < 260; streak += 1) {
    const x = random() * width
    const phase = random() * Math.PI * 2
    const tone = Math.round(28 + random() * 96)
    context.strokeStyle = `rgba(${tone}, ${Math.round(tone * 0.78)}, ${Math.round(tone * 0.56)}, ${0.16 + random() * 0.4})`
    context.lineWidth = 1 + random() * 3.5
    for (const wrap of [-width, 0, width]) {
      context.beginPath()
      for (let y = 0; y <= height; y += 16) {
        context.lineTo(x + wrap + Math.sin((y / height) * Math.PI * 4 + phase) * 5, y)
      }
      context.stroke()
    }
  }

  const texture = new THREE.CanvasTexture(context.canvas)
  texture.colorSpace = THREE.SRGBColorSpace
  texture.wrapS = THREE.RepeatWrapping
  texture.wrapT = THREE.RepeatWrapping
  texture.repeat.set(3, 2)
  texture.anisotropy = 4
  return texture
}

function createMoteTexture(): THREE.CanvasTexture {
  const size = 64
  const context = canvasContext(size, size)
  const glow = context.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
  glow.addColorStop(0, "rgba(255, 255, 255, 1)")
  glow.addColorStop(0.3, "rgba(255, 232, 197, 0.5)")
  glow.addColorStop(1, "rgba(255, 208, 150, 0)")
  context.fillStyle = glow
  context.fillRect(0, 0, size, size)
  const texture = new THREE.CanvasTexture(context.canvas)
  texture.colorSpace = THREE.SRGBColorSpace
  return texture
}

// A swept tube with a per-ring radius, which is what gives the trunk its root
// flare and its taper to a closed point.
function sweep(
  curve: THREE.Curve<THREE.Vector3>,
  segments: number,
  sides: number,
  radiusAt: (along: number) => number,
): THREE.BufferGeometry {
  const frames = curve.computeFrenetFrames(segments, false)
  const positions: number[] = []
  const normals: number[] = []
  const uvs: number[] = []
  const indices: number[] = []
  const center = new THREE.Vector3()
  const outward = new THREE.Vector3()

  for (let ring = 0; ring <= segments; ring += 1) {
    const along = ring / segments
    const radius = radiusAt(along)
    curve.getPointAt(along, center)
    for (let side = 0; side <= sides; side += 1) {
      const angle = (side / sides) * Math.PI * 2
      outward
        .copy(frames.normals[ring])
        .multiplyScalar(Math.cos(angle))
        .addScaledVector(frames.binormals[ring], Math.sin(angle))
      const gnarl = 1 + Math.sin(angle * 3 + along * 24) * 0.05 + Math.sin(angle * 7 - along * 13) * 0.028
      positions.push(
        center.x + outward.x * radius * gnarl,
        center.y + outward.y * radius * gnarl,
        center.z + outward.z * radius * gnarl,
      )
      normals.push(outward.x, outward.y, outward.z)
      uvs.push(side / sides, along)
    }
  }

  for (let ring = 0; ring < segments; ring += 1) {
    for (let side = 0; side < sides; side += 1) {
      const corner = ring * (sides + 1) + side
      const next = corner + sides + 1
      indices.push(corner, corner + 1, next, next, corner + 1, next + 1)
    }
  }

  const geometry = new THREE.BufferGeometry()
  geometry.setAttribute("position", new THREE.Float32BufferAttribute(positions, 3))
  geometry.setAttribute("normal", new THREE.Float32BufferAttribute(normals, 3))
  geometry.setAttribute("uv", new THREE.Float32BufferAttribute(uvs, 2))
  geometry.setIndex(indices)
  return geometry
}

const trunkCurve = new THREE.CatmullRomCurve3([
  new THREE.Vector3(0, -0.45, 0),
  new THREE.Vector3(0.07, 0.85, -0.13),
  new THREE.Vector3(-0.11, 2.05, 0.17),
  new THREE.Vector3(0.15, 3.25, -0.07),
  new THREE.Vector3(-0.02, 4.35, 0.11),
  new THREE.Vector3(0.12, 5.15, 0.02),
])

const trunkGeometry = sweep(trunkCurve, 110, 16, (along) =>
  (0.075 + 0.3 * Math.pow(1 - along, 1.8) + 0.3 * Math.exp(-along * 7)) *
  Math.min(1, (1 - along) * 9),
)

const barkTexture = createBarkTexture()
const trunkMaterial = new THREE.MeshStandardMaterial({
  color: "#8a705a",
  map: barkTexture,
  roughness: 0.94,
})

const trunk = new THREE.Mesh(trunkGeometry, trunkMaterial)
trunk.castShadow = true
trunk.receiveShadow = true
scene.add(trunk)
onDispose(() => {
  barkTexture.dispose()
  trunkGeometry.dispose()
  trunkMaterial.dispose()
})

// Both nested loads share this URL, so the host's loader.reload() for
// branch.glts rebuilds the bough and the instanced crown together.
const branchURL = new URL("./branch.glts", import.meta.url)
const crown = new THREE.Group()
crown.name = "Crown"
scene.add(crown)

const bough = await gltsLoader.loadAsync(branchURL)
crown.add(bough)
const branches = await gltsLoader.loadInstancesAsync(branchURL, BRANCHES)
crown.add(branches)

const boughPivot = new THREE.Group()
boughPivot.position.set(0.2, 1.62, 0.14)
boughPivot.add(bough)
bough.quaternion.setFromUnitVectors(UP, new THREE.Vector3(0.88, 0.34, 0.33).normalize())
bough.scale.setScalar(1.12)
crown.add(boughPivot)

const placements = []
const heading = new THREE.Vector3()

for (let index = 0; index < BRANCHES; index += 1) {
  const up = index / (BRANCHES - 1)
  const spiral = index * 2.39996 + 0.7
  const tilt = 1.18 - up * 0.74 + (random() - 0.5) * 0.14
  const size = (1.14 - up * 0.42) * (0.86 + random() * 0.28)
  heading
    .set(Math.cos(spiral) * Math.sin(tilt), Math.cos(tilt), Math.sin(spiral) * Math.sin(tilt))
    .normalize()

  placements.push({
    amount: 0.045 + random() * 0.055,
    phase: random() * Math.PI * 2,
    position: new THREE.Vector3(heading.x * 0.17, 2.35 + up * 2.6 + (random() - 0.5) * 0.16, heading.z * 0.17),
    quaternion: new THREE.Quaternion()
      .setFromUnitVectors(UP, heading)
      .multiply(new THREE.Quaternion().setFromAxisAngle(UP, random() * Math.PI * 2)),
    scale: new THREE.Vector3(size, size * (0.92 + random() * 0.22), size),
    speed: 0.65 + random() * 0.55,
  })
}

const motePositions = new Float32Array(MOTES * 3)
const moteColors = new Float32Array(MOTES * 3)
const moteDrift = []
const moteTint = new THREE.Color()

for (let index = 0; index < MOTES; index += 1) {
  moteDrift.push({
    angle: random() * Math.PI * 2,
    height: 0.3 + random() * 6,
    radius: 0.5 + random() * 3.4,
    rise: 0.05 + random() * 0.11,
    spin: (random() - 0.5) * 0.2,
  })
  moteTint.setHSL(0.07 + random() * 0.05, 0.6, 0.42 + random() * 0.3)
  moteColors[index * 3] = moteTint.r
  moteColors[index * 3 + 1] = moteTint.g
  moteColors[index * 3 + 2] = moteTint.b
}

const moteGeometry = new THREE.BufferGeometry()
const moteAttribute = new THREE.BufferAttribute(motePositions, 3)
moteGeometry.setAttribute("position", moteAttribute)
moteGeometry.setAttribute("color", new THREE.BufferAttribute(moteColors, 3))

const moteTexture = createMoteTexture()
const moteMaterial = new THREE.PointsMaterial({
  blending: THREE.AdditiveBlending,
  depthWrite: false,
  map: moteTexture,
  size: 0.075,
  sizeAttenuation: true,
  transparent: true,
  vertexColors: true,
})

const motes = new THREE.Points(moteGeometry, moteMaterial)
motes.name = "Pollen"
motes.frustumCulled = false
scene.add(motes)

let elapsed = 0
const gustQuaternion = new THREE.Quaternion()
const branchQuaternion = new THREE.Quaternion()
const branchMatrix = new THREE.Matrix4()

onFrame((delta) => {
  elapsed += delta
  const gust = 0.55 + 0.45 * Math.sin(elapsed * 0.23)

  crown.rotation.z = Math.sin(elapsed * 0.41) * 0.015 * gust
  crown.rotation.x = Math.sin(elapsed * 0.29 + 1.1) * 0.011 * gust
  boughPivot.quaternion.setFromAxisAngle(WIND, Math.sin(elapsed * 0.63 + 2.2) * 0.05 * gust)

  // Explicit composition: every branch is one instance, and each pose is
  // written back through setMatrixAt().
  for (let index = 0; index < BRANCHES; index += 1) {
    const branch = placements[index]
    const sway = Math.sin(elapsed * branch.speed + branch.phase) * branch.amount * gust
    gustQuaternion.setFromAxisAngle(WIND, sway)
    branchQuaternion.copy(gustQuaternion).multiply(branch.quaternion)
    branchMatrix.compose(branch.position, branchQuaternion, branch.scale)
    branches.setMatrixAt(index, branchMatrix)
  }

  for (let index = 0; index < MOTES; index += 1) {
    const mote = moteDrift[index]
    mote.height += mote.rise * delta
    if (mote.height > 6.4) {
      mote.height = 0.25
    }
    mote.angle += mote.spin * delta
    const wobble = Math.sin(elapsed * 0.8 + index) * 0.14
    motePositions[index * 3] = Math.cos(mote.angle) * (mote.radius + wobble)
    motePositions[index * 3 + 1] = mote.height
    motePositions[index * 3 + 2] = Math.sin(mote.angle) * (mote.radius + wobble)
  }
  moteAttribute.needsUpdate = true
})

// Only what this script created. The nested bough and branches are managed nodes
// and GLTS disposes them recursively.
onDispose(() => {
  moteTexture.dispose()
  moteGeometry.dispose()
  moteMaterial.dispose()
})
