{
  "name": "@drawcall/glts",
  "version": "0.7.1",
  "type": "module",
  "bin": {
    "glts": "./dist/cli/index.js"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "description": "Like glTF, but for procedural Three.js assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/glts.git",
    "directory": "packages/glts"
  },
  "bugs": {
    "url": "https://github.com/drawcall-ai/glts/issues"
  },
  "homepage": "https://github.com/drawcall-ai/glts#readme",
  "keywords": [
    "three",
    "threejs",
    "procedural",
    "assets",
    "loader",
    "hot-reload",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "pnpm build && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@drawcall/webgl": "^0.1.0",
    "@napi-rs/canvas": "^1.0.11",
    "commander": "^15.0.0",
    "es-module-lexer": "^2.0.0",
    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "three": ">=0.182.0",
    "typescript": "^5.0.0 || ^6.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.17"
  }
}
