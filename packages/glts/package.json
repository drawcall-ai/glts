{
  "name": "@drawcall/glts",
  "version": "0.7.1",
  "type": "module",
  "description": "Like glTF, but for procedural Three.js assets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/glts.git",
    "directory": "packages/glts"
  },
  "bugs": {
    "url": "https://github.com/drawcall-ai/glts/issues"
  },
  "homepage": "https://github.com/drawcall-ai/glts#readme",
  "keywords": [
    "three",
    "threejs",
    "procedural",
    "assets",
    "loader",
    "hot-reload",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "pnpm build && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "es-module-lexer": "^2.0.0",
    "magic-string": "^0.30.21",
    "sucrase": "3.35.1",
    "@drawcall/physics": "^0.13.1"
  },
  "peerDependencies": {
    "@drawcall/physics-usd": "^0.13.1",
    "three": ">=0.182.0"
  },
  "peerDependenciesMeta": {
    "@drawcall/physics-usd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@drawcall/physics-usd": "^0.13.1",
    "@types/three": "^0.185.0",
    "three": "^0.185.1",
    "vitest": "^4.0.17"
  }
}
